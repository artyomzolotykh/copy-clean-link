{
  "manifest_version": 3,
  "name": "Copy Clean Link",
  "version": "0.1.0",
  "description": "Remove all query parameters and copy a clean URL.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "clipboardWrite",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Copy Clean Link",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
